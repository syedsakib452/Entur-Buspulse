# Copy to analysis/.env and fill in your OpenStack credentials; never commit the real .env.
OS_AUTH_URL=https://identity.example/v3
OS_AUTH_TYPE=v3applicationcredential
OS_APPLICATION_CREDENTIAL_ID=
OS_APPLICATION_CREDENTIAL_SECRET=
OS_PROJECT_ID=
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default
OS_REGION_NAME=
OS_INTERFACE=public
RAW_CONTAINER=buspulse-raw
BRONZE_PROCS=4
BRONZE_DL_THREADS=3
START_DATE=2026-10-20
END_DATE=
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=1400m
SPARK_SHUFFLE_PARTITIONS=16
